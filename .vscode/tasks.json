{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EcoNexa: Start All Services",
      "dependsOn": [
        "1. ML Service (FastAPI)",
        "2. Backend (Node.js)",
        "3. Frontend (Vite React)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "1. ML Service (FastAPI)",
      "type": "shell",
      "command": "python -m uvicorn app:app --port 5001 --reload",
      "options": {
        "cwd": "${workspaceFolder}/ml_service"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "smartwaste",
        "reveal": "always"
      }
    },
    {
      "label": "2. Backend (Node.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "smartwaste",
        "reveal": "always"
      }
    },
    {
      "label": "3. Frontend (Vite React)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "smartwaste",
        "reveal": "always"
      }
    },
    {
      "label": "Run Backend Test Suite",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
